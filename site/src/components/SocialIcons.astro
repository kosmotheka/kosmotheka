---
import Default from "@astrojs/starlight/components/SocialIcons.astro";

const text = "kosmotheka.com";
// The website in the page's language, so going back does not switch languages.
const href = `https://kosmotheka.com/${Astro.currentLocale === "en" ? "en" : "es"}/`;
---

<a class="site-link" href={href} rel="noopener">{text}</a>
<Default><slot /></Default>

<style>
  .site-link {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }
  .site-link:hover {
    color: var(--sl-color-white);
  }
</style>
