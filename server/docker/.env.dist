# Copy to server/docker/.env. docker/.env does NOT go to the repository.

COMPOSE_PROJECT_NAME=library

# The app is mounted at /var/www/${SYMFONY_APP_NAME} inside the containers.
# Paths are relative to server/docker/, where the compose lives.
SYMFONY_APP_NAME=library.local
SYMFONY_APP_PATH=..
SPEC_PATH=../../spec

# PostgreSQL. Host port 5433. Development credentials only.
POSTGRES_DB=library
POSTGRES_USER=library
POSTGRES_PASSWORD=library

# Instants are stored in UTC.
TIMEZONE=UTC
