# Copy to server/docker/.env. docker/.env does NOT go to the repository.

COMPOSE_PROJECT_NAME=kosmotheka

# The app is mounted at /var/www/${SYMFONY_APP_NAME} inside the containers.
# Paths are relative to server/docker/, where the compose lives.
SYMFONY_APP_NAME=kosmotheka.local
SYMFONY_APP_PATH=..
SPEC_PATH=../../spec

# PostgreSQL. Host port 5433. Development credentials only.
POSTGRES_DB=kosmotheka
POSTGRES_USER=kosmotheka
POSTGRES_PASSWORD=kosmotheka

# Instants are stored in UTC.
TIMEZONE=UTC

# Live notices hub (milestone 7.3). Two different keys, 32 bytes or more; the same
# values go in server/.env.local. Generate each with: openssl rand -hex 32
MERCURE_PUBLISHER_JWT_KEY=
MERCURE_SUBSCRIBER_JWT_KEY=
