# Copy to .env (same folder). .env is NOT versioned: it holds secrets.
# The whole file reaches the PHP containers as environment variables, so every variable
# of server/.env (docs: site "La configuración, variable a variable") can go here too.

# --- Compose ---
COMPOSE_PROJECT_NAME=kosmotheka
# Where nginx listens (plain HTTP; HTTPS is a proxy's job).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Required ---
# openssl rand -hex 32
APP_SECRET=
# The public address, no trailing slash: https://your-domain
DEFAULT_URI=
INVITATION_BASE_URL=
# openssl rand -base64 32   (base64, not hex)
CLOUD_KEY_SECRET=
# The TLS proxy reaches nginx from a Docker address, not 127.0.0.1: leave REMOTE_ADDR in.
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

# --- Optional: see the configuration page for each one ---
# MAILER_DSN=
# MAILER_FROM=
# REGISTRATION_ALLOWED_EMAILS=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Optional: live notices, `docker compose --profile mercure up -d` ---
# Two different keys: openssl rand -hex 32
# MERCURE_URL=http://mercure/.well-known/mercure
# MERCURE_PUBLISHER_JWT_KEY=
# MERCURE_SUBSCRIBER_JWT_KEY=
