# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'

###> doctrine/doctrine-bundle ###
# Doctrine appends "_test" to the name (config/packages/doctrine.yaml), so this
# points at kosmotheka_test. The "test" role only exists inside the db_kosmotheka
# container and owns only that database (docker/postgres/init).
DATABASE_URL="postgresql://test:test@db_kosmotheka:5432/kosmotheka?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

# Tests never send real email; MailerAssertionsTrait reads messages from the
# in-memory transport instead.
MAILER_DSN=null://null

# Live notices: a hub that does not exist (the tests record what would be
# published) and keys that only mean something here. Never use them anywhere else.
MERCURE_URL=http://mercure.test/.well-known/mercure
MERCURE_PUBLISHER_JWT_KEY=test-only-publisher-key-0123456789abcdef
MERCURE_SUBSCRIBER_JWT_KEY=test-only-subscriber-key-fedcba9876543210
