# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET=

###> doctrine/doctrine-bundle ###
# Doctrine appends "_test" to the name (config/packages/doctrine.yaml), so this
# points at kosmotheka_test. The "test" role only exists inside the db_kosmotheka
# container and owns only that database (docker/postgres/init).
DATABASE_URL="postgresql://test:test@db_kosmotheka:5432/kosmotheka?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###
