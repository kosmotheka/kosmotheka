# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
# No credentials here: this file is committed. The real URL goes in .env.local
# (not versioned); for development, copy it from docs/development/server.md.
# serverVersion must say 18: Doctrine generates SQL for the version it is told.
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/kosmotheka?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Placeholder: sends nowhere. Development overrides it in .env.local to reach
# Mailpit; production sets the real Brevo DSN in .env.local on the server
# (docs/architecture/accounts.md documents the account emails that use it).
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/brevo-mailer ###
# MAILER_DSN=brevo+api://KEY@default
# MAILER_DSN=brevo+smtp://USERNAME:PASSWORD@default
###< symfony/brevo-mailer ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> account mail ###
MAILER_FROM=no-reply@kosmotheka.com
###< account mail ###

###> two factor (D78) ###
# Turns second-factor setup off for new accounts; existing ones still have to
# use it at login (App\Controller\ServerController, App\Security\TwoFactor).
TWO_FACTOR_ENABLED=true
###< two factor (D78) ###

###> trusted proxies ###
# The production server sits behind nginx and perhaps a CDN.
TRUSTED_PROXIES=127.0.0.1
###< trusted proxies ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mercure-bundle ###
# Live notices (milestone 7.3, D75). Mercure is optional (D18): with MERCURE_URL
# empty the server publishes nothing and says `events: false`. No keys here: they
# go in .env.local (docs/development/server.md).
# The hub's internal address, which is also the audience (`aud`) of its tokens.
MERCURE_URL=
MERCURE_PUBLISHER_JWT_KEY=
MERCURE_SUBSCRIBER_JWT_KEY=
###< symfony/mercure-bundle ###

###> cloud identity (milestone 7.5.2a, D95) ###
# Encrypts the private key each cloud library signs with. 32 random bytes in base64
# (`openssl rand -base64 32`), defined in .env.local and in production (docs/development/server.md).
# Empty = the cloud is optional (D18): libraries get no cloud device. Losing it leaves
# the libraries already created unable to sign.
CLOUD_KEY_SECRET=
###< cloud identity ###

###> invitations (milestone 7.6.1, D43, D79) ###
# The address invitation links start with: `<this>/i/<token>`. `https://kosmotheka.app` in the
# official server; whoever hosts their own sets theirs in .env.local. Empty = the server makes no
# invitations (D18) and `GET /v1/server` says `invitations: false`.
INVITATION_BASE_URL=
###< invitations ###

###> closed registration ###
# Addresses that may make an account, separated by commas. Empty = anybody (the default). With
# addresses, everybody else gets `registration_closed` and `GET /v1/server` says
# `registration_restricted: true`. Whoever already has an account signs in as always.
REGISTRATION_ALLOWED_EMAILS=
###< closed registration ###

###> google sign-in (D77) ###
# The OAuth client of «Continuar con Google», from the Google Cloud console (docs/architecture/accounts.md). Both empty
# = no Google on this server: its routes do nothing and `GET /v1/server` says `sign_in_with_google: false`. Put them in
# `.env.local`, never in the repository. The redirect URI to register at Google is `DEFAULT_URI` + `/v1/auth/google/callback`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
###< google sign-in ###

###> google books (7.8, D83) ###
# The server's key for Google Books, so accounts can look an ISBN up through it. Empty = not offered: the route says
# `metadata_unavailable` and `GET /v1/server` lists no `metadata`. The key goes in a header, never in an address. Put it
# in `.env.local`, never in the repository (docs/development/server.md).
GOOGLE_BOOKS_API_KEY=
###< google books ###

###> tmdb (7.8, D62) ###
# The server's «API Read Access Token» of TMDB, so accounts can search films and series by title through it. Empty = not
# offered: the route says `metadata_unavailable` and `GET /v1/server` does not list `tmdb`. It goes in a header, never
# in an address. Put it in `.env.local`, never in the repository (docs/development/server.md).
TMDB_API_TOKEN=
###< tmdb ###

###> boardgamegeek (7.8, D62) ###
# The token of the application registered with BoardGameGeek, so accounts can search board games (and, with the same
# token, role-playing books on RPGGeek) by title through the server. Empty = not offered: the route says
# `metadata_unavailable` and `GET /v1/server` does not list `bgg`. It goes in a header, never in an address. Put it in
# `.env.local`, never in the repository (docs/development/server.md).
BGG_API_TOKEN=
# The most real calls the server makes to BoardGameGeek and RPGGeek a day, together. They publish no figure: look at the
# «Usage» of the registered application and change this without touching code.
BGG_DAILY_CALL_CAP=1000
###< boardgamegeek ###

###> gameupc (D62) ###
# The server's GameUPC key, so accounts can find which board game the barcode on a box is, and send back the game they
# chose when GameUPC was not sure. Empty = not offered: the routes say `metadata_unavailable` and `GET /v1/server` does
# not list `gameupc`. It goes in a header, never in an address. GameUPC gives it by email to whoever makes the app. Put it
# in `.env.local`, never in the repository (docs/development/server.md).
GAMEUPC_API_KEY=
###< gameupc ###

###> rawg (7.8, D62) ###
# The server's RAWG API key, so accounts can search video games by title through it. Empty = not offered: the route says
# `metadata_unavailable` and `GET /v1/server` does not list `rawg`. RAWG only takes it in the address of the call, so it is
# handled with care (docs/architecture/cloud.md). Put it in `.env.local`, never in the repository.
RAWG_API_KEY=
###< rawg ###

###> comic vine (7.8, D62) ###
# The server's Comic Vine API key, so accounts can search comics by title through it. Empty = not offered: the route says
# `metadata_unavailable` and `GET /v1/server` does not list `comic_vine`. Comic Vine only takes it in the address of the
# call, so it is handled with care (docs/architecture/cloud.md). Put it in `.env.local`, never in the repository.
COMIC_VINE_API_KEY=
###< comic vine ###

###> device sign-in proof (D100) ###
# Other addresses by which this same server is reached, besides DEFAULT_URI, separated by commas (development only:
# the Android emulator at http://10.0.2.2:8095, a phone at http://192.168.1.20:8095). A device signs the address it
# signs in to; one made for an address in neither is worth nothing. Empty by default, and always empty in production.
SERVER_EXTRA_ORIGINS=
###< device sign-in proof ###

###> covers (D82) ###
# The most bytes of cover files the server keeps for all the cloud libraries together (5 GB). Above it, covers are
# refused and everything else keeps working.
COVERS_SERVER_MAX_BYTES=5368709120
###< covers ###
