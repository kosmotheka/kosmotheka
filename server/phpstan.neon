# Level 6 and no baseline. phpstan/phpstan-doctrine knows Doctrine assigns ids
# by reflection, so there is no entity noise to freeze. If a baseline is ever
# needed, let it be explicit.
#
# The extensions register themselves via phpstan/extension-installer.
parameters:
    level: 6
    paths:
        - src
        - tests
    excludePaths:
        # Generated by the phpunit recipe and regenerated on its own.
        - tests/bootstrap.php
    doctrine:
        # With the EntityManager in front, phpstan-doctrine also validates DQL:
        # a misspelled field in a query fails the analysis.
        objectManagerLoader: phpstan-em.php
    ignoreErrors:
        # The kernel trait calls it by name; PHPStan cannot see that.
        -
            identifier: method.unused
            path: src/Kernel.php
            message: '#getAllowedEnvs#'
