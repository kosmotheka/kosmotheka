# The highest level and no baseline. phpstan/phpstan-doctrine knows Doctrine assigns ids
# by reflection, so there is no entity noise to freeze. If a baseline is ever
# needed, let it be explicit.
#
# The extensions register themselves via phpstan/extension-installer.
parameters:
    level: max
    # A response read before another request is not the same response: do not
    # carry what was asserted about a method's result past the next call.
    rememberPossiblyImpureFunctionValues: false
    paths:
        - src
        - tests
    # Migrations are not autoloaded; a test of one has to be able to name it.
    scanFiles:
        - migrations/Version20261016120000.php
    excludePaths:
        # Generated by the phpunit recipe and regenerated on its own.
        - tests/bootstrap.php
    symfony:
        # The test container, so `getContainer()->get(Foo::class)` in tests is a Foo.
        # `make phpstan` and CI warm it first.
        containerXmlPath: var/cache/test/App_KernelTestDebugContainer.xml
    doctrine:
        # With the EntityManager in front, phpstan-doctrine also validates DQL:
        # a misspelled field in a query fails the analysis.
        objectManagerLoader: phpstan-em.php
    ignoreErrors:
        # The kernel trait calls it by name; PHPStan cannot see that.
        -
            identifier: method.unused
            path: src/Kernel.php
            message: '#getAllowedEnvs#'
            # Newer Symfony versions no longer report it: do not fail when it is gone.
            reportUnmatched: false
