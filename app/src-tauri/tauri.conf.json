{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kosmotheka",
  "version": "0.2.1",
  "identifier": "app.kosmotheka",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kosmotheka",
        "width": 1024,
        "height": 720,
        "maximized": true,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: https:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/covers/*"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["https"],
          "host": "kosmotheka.app",
          "pathPrefix": ["/i/"],
          "appLink": true
        },
        {
          "scheme": ["kosmotheka"],
          "host": "auth",
          "pathPrefix": ["/google"]
        }
      ],
      "desktop": {
        "schemes": ["kosmotheka"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
