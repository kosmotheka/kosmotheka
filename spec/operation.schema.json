{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kosmotheka.app/spec/operation.schema.json",
  "title": "Operation",
  "description": "An atomic batch of entity changes with an intent label. Every write to the catalog is one operation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "library",
    "hlc",
    "intent",
    "changes"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/uuid"
    },
    "library": {
      "description": "Id of the library the operation belongs to: the unit that is shared, synced and permissioned. Changes never name a library themselves.",
      "$ref": "#/$defs/uuid"
    },
    "hlc": {
      "description": "Hybrid logical clock timestamp: 16-digit milliseconds, 8-hex-digit counter, device id.",
      "type": "string",
      "pattern": "^[0-9]{16}-[0-9a-f]{8}-.+$"
    },
    "intent": {
      "description": "What the user meant, e.g. book.add. Informative only: permissions and merging look at the changes.",
      "type": "string",
      "pattern": "^[a-z_]+(\\.[a-z_]+)+$"
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "signature": {
      "description": "Ed25519 signature by the device in the hlc over the operation without this field, in canonical JSON (RFC 8785); base64url without padding. Operations from before signatures existed have none.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "integer": {
      "type": [
        "integer",
        "null"
      ]
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity",
        "id",
        "action"
      ],
      "properties": {
        "entity": {
          "enum": [
            "library",
            "work",
            "person",
            "work_contributor",
            "edition",
            "book_details",
            "member",
            "copy",
            "publisher",
            "wish",
            "revocation",
            "device",
            "change_request",
            "mark"
          ]
        },
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "action": {
          "enum": [
            "create",
            "update",
            "delete"
          ]
        },
        "fields": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "delete"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "fields"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "update"
              }
            }
          },
          "then": {
            "required": [
              "fields"
            ],
            "properties": {
              "fields": {
                "minProperties": 1
              }
            }
          }
        },
        {
          "description": "A mark is never deleted by a change (D68): the tombstone would keep its derived id, and so its person, from ever marking the work again. It goes with its work or its person.",
          "if": {
            "properties": {
              "entity": {
                "const": "mark"
              }
            }
          },
          "then": {
            "properties": {
              "action": {
                "enum": [
                  "create",
                  "update"
                ]
              }
            }
          }
        },
        {
          "$ref": "#/$defs/entityFields"
        }
      ]
    },
    "entityFields": {
      "description": "Fields each entity accepts. Required fields must be present on create and may never be null. A null ref or text clears an optional field.",
      "allOf": [
        {
          "if": {
            "properties": {
              "entity": {
                "const": "work"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "book"
                    ]
                  },
                  "title": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity": {
                "enum": [
                  "library",
                  "person",
                  "publisher"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity": {
                "const": "member"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "role": {
                    "description": "The member's role in the library (D73). Null or absent: no role.",
                    "enum": [
                      "admin",
                      "editor",
                      "reader",
                      null
                    ]
                  },
                  "can_share": {
                    "description": "Whether the member may share the library with other devices or people (D55).",
                    "$ref": "#/$defs/boolean"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity": {
                "const": "work_contributor"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "additionalProperties": false,
                "properties": {
                  "work_id": {
                    "$ref": "#/$defs/uuid"
                  },
                  "person_id": {
                    "$ref": "#/$defs/uuid"
                  },
                  "role": {
                    "enum": [
                      "author"
                    ]
                  },
                  "position": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity": {
                "const": "edition"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "additionalProperties": false,
                "properties": {
                  "work_id": {
                    "$ref": "#/$defs/uuid"
                  },
                  "title": {
                    "type": "string"
                  },
                  "subtitle": {
                    "$ref": "#/$defs/text"
                  },
                  "publisher_id": {
                    "$ref": "#/$defs/ref"
                  },
                  "published_year": {
                    "$ref": "#/$defs/integer"
                  },
                  "language": {
                    "$ref": "#/$defs/text"
                  },
                  "cover": {
                    "description": "File name of the cover image: sha256 of its bytes plus extension.",
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9a-f]{64}\\.(jpg|png|webp|gif)$"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity": {
                "const": "book_details"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "additionalProperties": false,
                "properties": {
                  "isbn13": {
                    "$ref": "#/$defs/text"
                  },
                  "google_books_id": {
                    "$ref": "#/$defs/text"
                  },
                  "open_library_id": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity": {
                "const": "copy"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "additionalProperties": false,
                "properties": {
                  "edition_id": {
                    "$ref": "#/$defs/uuid"
                  },
                  "owner_id": {
                    "$ref": "#/$defs/ref"
                  },
                  "format": {
                    "enum": [
                      "hardcover",
                      "paperback",
                      "pocket",
                      "ebook",
                      "audiobook",
                      "other"
                    ]
                  },
                  "quantity": {
                    "type": "integer"
                  },
                  "location": {
                    "$ref": "#/$defs/text"
                  },
                  "acquired_on": {
                    "$ref": "#/$defs/date"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity": {
                "const": "wish"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "author": {
                    "$ref": "#/$defs/text"
                  },
                  "isbn13": {
                    "$ref": "#/$defs/text"
                  },
                  "note": {
                    "$ref": "#/$defs/text"
                  },
                  "cover_url": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity": {
                "const": "revocation"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "additionalProperties": false,
                "properties": {
                  "device_id": {
                    "type": "string"
                  },
                  "device_name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity": {
                "const": "device"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "additionalProperties": false,
                "properties": {
                  "public_key": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "member_id": {
                    "description": "The member this device belongs to (D55). Only administrators set it.",
                    "$ref": "#/$defs/ref"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity": {
                "const": "change_request"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "description": "How the request ended. An administrator accepts or rejects it (accepting repeats the requested changes in the same operation); whoever asked may withdraw it.",
                    "enum": [
                      "accepted",
                      "rejected",
                      "withdrawn",
                      null
                    ]
                  },
                  "note": {
                    "description": "What the asker wants to tell whoever decides. Travels inside the request itself, as a row only an administrator could create, so the operation stays a request.",
                    "$ref": "#/$defs/text"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "entity": {
                "const": "mark"
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "additionalProperties": false,
                "properties": {
                  "member_id": {
                    "description": "The person whose mark it is (D68).",
                    "$ref": "#/$defs/uuid"
                  },
                  "work_id": {
                    "$ref": "#/$defs/uuid"
                  },
                  "status": {
                    "description": "Where the person is with the work. Null or absent: not set.",
                    "enum": [
                      "pending",
                      "in_progress",
                      "finished",
                      "abandoned",
                      null
                    ]
                  },
                  "status_on": {
                    "description": "When the status was set.",
                    "$ref": "#/$defs/date"
                  },
                  "rating": {
                    "description": "From 1 to 5.",
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1,
                    "maximum": 5
                  },
                  "favorite": {
                    "$ref": "#/$defs/boolean"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "boolean": {
      "type": [
        "boolean",
        "null"
      ]
    }
  }
}
